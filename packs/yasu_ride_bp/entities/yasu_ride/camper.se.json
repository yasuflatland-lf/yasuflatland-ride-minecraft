    },
    "component_groups": {
      "yasu_ride:normalized_paint": { "minecraft:variant": { "value": 0 } },
      "yasu_ride:undocked": {
        "minecraft:collision_box": { "width": 3.0, "height": 4.0 }
      },
      "yasu_ride:docked": {
        "minecraft:physics": { "has_collision": false, "has_gravity": false },
        "minecraft:collision_box": { "width": 0.4, "height": 0.4 }
      },
      "yasu_ride:weightless": {
        "minecraft:physics": { "has_gravity": false }
      },
      "yasu_ride:weighted": { "minecraft:physics": {} }
    },
    "events": {
      "yasu_ride:normalize_paint": {
        "add": { "component_groups": ["yasu_ride:normalized_paint"] }
      },
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["yasu_ride:undocked"] }
      },
      "yasu_ride:dock": {
        "remove": {
          "component_groups": ["yasu_ride:weighted", "yasu_ride:undocked"]
        },
        "add": { "component_groups": ["yasu_ride:docked"] }
      },
      "yasu_ride:undock": {
        "remove": { "component_groups": ["yasu_ride:docked"] },
        "add": {
          "component_groups": ["yasu_ride:weighted", "yasu_ride:undocked"]
        }
      },
      "yasu_ride:gravity_off": {
        "add": { "component_groups": ["yasu_ride:weightless"] },
        "remove": { "component_groups": ["yasu_ride:weighted"] }
      },
      "yasu_ride:gravity_on": {
        "add": { "component_groups": ["yasu_ride:weighted"] },
        "remove": { "component_groups": ["yasu_ride:weightless"] }
      }
    },
    "components": {
      "minecraft:variant": { "value": 0 },
      "minecraft:type_family": {
        "family": ["yasu_ride_vehicle", "inanimate"]
      },
      "minecraft:collision_box": { "width": 3.0, "height": 4.0 },
      "minecraft:custom_hit_test": {
        "hitboxes": [{ "width": 0.1, "height": 0.1, "pivot": [0, 0.05, 0] }]
      },
      "minecraft:health": { "value": 20, "max": 20 },
