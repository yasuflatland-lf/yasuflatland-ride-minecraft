{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.yasu_ride.camper": {
      "arrays": {
        "textures": {
          "Array.paints": [
            "Texture.default",
            "Texture.green",
            "Texture.red",
            "Texture.white",
            "Texture.light_gray",
            "Texture.gray",
            "Texture.black",
            "Texture.orange",
            "Texture.yellow",
            "Texture.lime",
            "Texture.cyan",
            "Texture.light_blue",
            "Texture.blue",
            "Texture.purple",
            "Texture.magenta",
            "Texture.pink"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        },
        {
          "headlights": "Material.lamp"
        },
        {
          "ceiling_lights": "Material.lamp"
        },
        {
          "glass": "Material.glass"
        },
        {
          "door_glass": "Material.glass"
        }
      ],
      "textures": ["Array.paints[query.variant]"],
      "part_visibility": [
        {
          "*": true
        },
        {
          "glow_*": false
        },
        {
          "headlights": "!query.property('yasu_ride:headlights')"
        },
        {
          "ceiling_lights": "!query.property('yasu_ride:ceiling_lights')"
        }
      ]
    },
    "controller.render.yasu_ride.camper.lit": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.lamp_lit"
        }
      ],
      "textures": ["Texture.lit"],
      "part_visibility": [
        {
          "*": false
        },
        {
          "headlights": "query.property('yasu_ride:headlights')"
        },
        {
          "ceiling_lights": "query.property('yasu_ride:ceiling_lights')"
        }
      ]
    },
    "controller.render.yasu_ride.camper.glow": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.lamp_lit"
        }
      ],
      "textures": ["Texture.lit"],
      "part_visibility": [
        {
          "*": false
        },
        {
          "glow_*": "!query.property('yasu_ride:gear_down')"
        }
      ]
    }
  }
}
