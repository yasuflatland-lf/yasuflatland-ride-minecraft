{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.yasu_ride.camper": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        },
        {
          "headlights": "Material.lamp"
        },
        {
          "ceiling_lights": "Material.lamp"
        },
        {
          "glass": "Material.glass"
        },
        {
          "door_glass": "Material.glass"
        }
      ],
      "textures": ["Texture.default"],
      "part_visibility": [
        {
          "*": true
        },
        {
          "glow_*": false
        },
        {
          "mirror": false
        },
        {
          "headlights": "!query.property('yasu_ride:headlights')"
        },
        {
          "ceiling_lights": "!query.property('yasu_ride:ceiling_lights')"
        }
      ]
    },
    "controller.render.yasu_ride.camper.mirror": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": ["Texture.mirror"],
      "part_visibility": [
        {
          "*": false
        },
        {
          "mirror": true
        }
      ]
    },
    "controller.render.yasu_ride.camper.lit": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.lamp_lit"
        }
      ],
      "textures": ["Texture.lit"],
      "part_visibility": [
        {
          "*": false
        },
        {
          "headlights": "query.property('yasu_ride:headlights')"
        },
        {
          "ceiling_lights": "query.property('yasu_ride:ceiling_lights')"
        }
      ]
    },
    "controller.render.yasu_ride.camper.glow": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.lamp_lit"
        }
      ],
      "textures": ["Texture.lit"],
      "part_visibility": [
        {
          "*": false
        },
        {
          "glow_*": "!query.property('yasu_ride:gear_down')"
        }
      ]
    },
    "controller.render.yasu_ride.camper.drawer_items": {
      "geometry": "Geometry.drawer_items",
      "materials": [
        {
          "*": "Material.cutout"
        },
        {
          "drawer_*_item_sugar_pot": "Material.glass"
        }
      ],
      "textures": ["Texture.drawer_items"],
      "part_visibility": [
        {
          "*": false
        },
        {
          "drawer_top_item_saucepan": "q.property('yasu_ride:drawer_top_item') == 1"
        },
        {
          "drawer_top_item_mug_pair": "q.property('yasu_ride:drawer_top_item') == 2"
        },
        {
          "drawer_top_item_sugar_pot": "q.property('yasu_ride:drawer_top_item') == 3"
        },
        {
          "drawer_top_item_fruit_bowl": "q.property('yasu_ride:drawer_top_item') == 4"
        },
        {
          "drawer_top_item_transistor_radio": "q.property('yasu_ride:drawer_top_item') == 5"
        },
        {
          "drawer_top_item_book_stack": "q.property('yasu_ride:drawer_top_item') == 6"
        },
        {
          "drawer_top_item_road_map": "q.property('yasu_ride:drawer_top_item') == 7"
        },
        {
          "drawer_top_item_cushion": "q.property('yasu_ride:drawer_top_item') == 8"
        },
        {
          "drawer_top_item_tissue_box": "q.property('yasu_ride:drawer_top_item') == 9"
        },
        {
          "drawer_top_item_binoculars": "q.property('yasu_ride:drawer_top_item') == 10"
        },
        {
          "drawer_bottom_item_saucepan": "q.property('yasu_ride:drawer_bottom_item') == 1"
        },
        {
          "drawer_bottom_item_mug_pair": "q.property('yasu_ride:drawer_bottom_item') == 2"
        },
        {
          "drawer_bottom_item_sugar_pot": "q.property('yasu_ride:drawer_bottom_item') == 3"
        },
        {
          "drawer_bottom_item_fruit_bowl": "q.property('yasu_ride:drawer_bottom_item') == 4"
        },
        {
          "drawer_bottom_item_transistor_radio": "q.property('yasu_ride:drawer_bottom_item') == 5"
        },
        {
          "drawer_bottom_item_book_stack": "q.property('yasu_ride:drawer_bottom_item') == 6"
        },
        {
          "drawer_bottom_item_road_map": "q.property('yasu_ride:drawer_bottom_item') == 7"
        },
        {
          "drawer_bottom_item_cushion": "q.property('yasu_ride:drawer_bottom_item') == 8"
        },
        {
          "drawer_bottom_item_tissue_box": "q.property('yasu_ride:drawer_bottom_item') == 9"
        },
        {
          "drawer_bottom_item_binoculars": "q.property('yasu_ride:drawer_bottom_item') == 10"
        }
      ]
    }
  }
}
