{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.yasu_ride.roof_tent": {
      "arrays": {
        "textures": {
          "Array.paints": [
            "Texture.default",
            "Texture.green",
            "Texture.red",
            "Texture.white",
            "Texture.light_gray",
            "Texture.gray",
            "Texture.black",
            "Texture.orange",
            "Texture.yellow",
            "Texture.lime",
            "Texture.cyan",
            "Texture.light_blue",
            "Texture.blue",
            "Texture.purple",
            "Texture.magenta",
            "Texture.pink"
          ]
        }
      },
      "geometry": "query.property('yasu_ride:ladder') ? Geometry.suv : Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": ["Array.paints[query.variant]"],
      "part_visibility": [
        {
          "ladder": "query.property('yasu_ride:ladder')"
        }
      ]
    }
  }
}
