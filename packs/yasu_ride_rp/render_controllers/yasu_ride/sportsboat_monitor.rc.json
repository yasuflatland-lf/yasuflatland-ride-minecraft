{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.yasu_ride.sportsboat.monitor": {
      "geometry": "Geometry.monitor",
      "materials": [{ "*": "Material.lamp_lit" }],
      "textures": ["Texture.monitor"],
      "part_visibility": [
        { "*": false },
        {
          "screen_icebreaker_switch_off": "query.property('yasu_ride:monitor') == 1"
        },
        {
          "screen_icebreaker_switch_on": "query.property('yasu_ride:monitor') == 2"
        }
      ]
    }
  }
}
