{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.yasu_ride.sportsboat": {
      "arrays": {
        "textures": {
          "Array.paints": [
            "Texture.default",
            "Texture.green",
            "Texture.red",
            "Texture.white",
            "Texture.light_gray",
            "Texture.gray",
            "Texture.black",
            "Texture.orange",
            "Texture.yellow",
            "Texture.lime",
            "Texture.cyan",
            "Texture.light_blue",
            "Texture.blue",
            "Texture.purple",
            "Texture.magenta",
            "Texture.pink"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        { "*": "Material.default" },
        { "headlights": "Material.lamp" },
        { "windshield": "Material.glass" }
      ],
      "textures": ["Array.paints[query.variant]"],
      "part_visibility": [
        { "*": true },
        { "headlights": "!query.property('yasu_ride:headlights')" },
        { "mirror": false }
      ]
    },
    "controller.render.yasu_ride.sportsboat.mirror": {
      "geometry": "Geometry.default",
      "materials": [{ "*": "Material.default" }],
      "textures": ["Texture.mirror"],
      "part_visibility": [{ "*": false }, { "mirror": true }]
    },
    "controller.render.yasu_ride.sportsboat.lit": {
      "geometry": "Geometry.default",
      "materials": [{ "*": "Material.lamp_lit" }],
      "textures": ["Texture.lit"],
      "part_visibility": [
        { "*": false },
        { "headlights": "query.property('yasu_ride:headlights')" }
      ]
    }
  }
}
