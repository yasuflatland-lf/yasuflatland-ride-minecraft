        "exhaust_5": "animation.yasu_ride.scooter.exhaust_5"
      },
      "sound_effects": {
        "scooter_engine_0": "yasu_ride.scooter_engine_0",
        "scooter_engine_1": "yasu_ride.scooter_engine_1",
        "scooter_engine_2": "yasu_ride.scooter_engine_2",
        "scooter_engine_3": "yasu_ride.scooter_engine_3",
        "scooter_engine_4": "yasu_ride.scooter_engine_4",
        "scooter_engine_5": "yasu_ride.scooter_engine_5",
        "hover_0": "yasu_ride.hover_0",
        "hover_1": "yasu_ride.hover_1",
        "hover_2": "yasu_ride.hover_2",
        "hover_3": "yasu_ride.hover_3",
        "hover_4": "yasu_ride.hover_4",
        "hover_start": "yasu_ride.hover_start"
      },
      "particle_effects": {
        "hover_glow": "yasu_ride:hover_glow",
        "exhaust_smoke": "yasu_ride:exhaust_smoke"
      },
      "scripts": {
        "animate": [
          "form",
          "stand",
          "lean",
          "steer",
          {
            "engine_sound_0": "query.has_rider && query.property('yasu_ride:form') == 'car' && query.ground_speed < 1"
          },
          {
            "engine_sound_1": "query.has_rider && query.property('yasu_ride:form') == 'car' && query.ground_speed >= 1 && query.ground_speed < 4.5"
          },
          {
            "engine_sound_2": "query.has_rider && query.property('yasu_ride:form') == 'car' && query.ground_speed >= 4.5 && query.ground_speed < 8"
          },
          {
            "engine_sound_3": "query.has_rider && query.property('yasu_ride:form') == 'car' && query.ground_speed >= 8 && query.ground_speed < 11.5"
          },
          {
            "engine_sound_4": "query.has_rider && query.property('yasu_ride:form') == 'car' && query.ground_speed >= 11.5 && query.ground_speed < 15"
          },
          {
            "engine_sound_5": "query.has_rider && query.property('yasu_ride:form') == 'car' && query.ground_speed >= 15"
          },
          {
            "exhaust_0": "query.has_rider && query.property('yasu_ride:form') == 'car' && query.ground_speed < 1"
          },
          {
            "exhaust_1": "query.has_rider && query.property('yasu_ride:form') == 'car' && query.ground_speed >= 1 && query.ground_speed < 4.5"
          },
          {
            "exhaust_2": "query.has_rider && query.property('yasu_ride:form') == 'car' && query.ground_speed >= 4.5 && query.ground_speed < 8"
          },
          {
            "exhaust_3": "query.has_rider && query.property('yasu_ride:form') == 'car' && query.ground_speed >= 8 && query.ground_speed < 11.5"
          },
          {
            "exhaust_4": "query.has_rider && query.property('yasu_ride:form') == 'car' && query.ground_speed >= 11.5 && query.ground_speed < 15"
          },
          {
            "exhaust_5": "query.has_rider && query.property('yasu_ride:form') == 'car' && query.ground_speed >= 15"
          }
        ]
      },
      "render_controllers": [
        "controller.render.yasu_ride.scooter",
        {
          "controller.render.yasu_ride.scooter.glow": "!query.property('yasu_ride:gear_down')"
        },
        {
          "controller.render.yasu_ride.scooter.lit": "query.property('yasu_ride:headlights')"
        }
      ]
    }
  }
}
