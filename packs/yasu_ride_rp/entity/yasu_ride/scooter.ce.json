        "hover_sound_2": "animation.yasu_ride.scooter.hover_sound_2",
        "hover_sound_3": "animation.yasu_ride.scooter.hover_sound_3",
        "hover_sound_4": "animation.yasu_ride.scooter.hover_sound_4",
        "form": "controller.animation.yasu_ride.scooter.form",
        "stand": "controller.animation.yasu_ride.scooter.stand",
        "exhaust_0": "animation.yasu_ride.scooter.exhaust_0",
        "exhaust_1": "animation.yasu_ride.scooter.exhaust_1",
