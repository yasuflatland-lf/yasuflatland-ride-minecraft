        "stand_up": "animation.yasu_ride.scooter.stand_up",
        "wheels_deploy": "animation.yasu_ride.scooter.wheels_deploy",
        "wheels_folded": "animation.yasu_ride.scooter.wheels_folded",
        "wheels_retract": "animation.yasu_ride.scooter.wheels_retract",
        "hover_glow": "animation.yasu_ride.scooter.hover_glow",
        "engine_sound_0": "animation.yasu_ride.scooter.engine_sound_0",
        "engine_sound_1": "animation.yasu_ride.scooter.engine_sound_1",
        "engine_sound_2": "animation.yasu_ride.scooter.engine_sound_2",
        "engine_sound_3": "animation.yasu_ride.scooter.engine_sound_3",
