        "black": "textures/entity/yasu_ride/scooter_black",
        "orange": "textures/entity/yasu_ride/scooter_orange",
        "yellow": "textures/entity/yasu_ride/scooter_yellow",
        "lime": "textures/entity/yasu_ride/scooter_lime",
        "cyan": "textures/entity/yasu_ride/scooter_cyan",
        "light_blue": "textures/entity/yasu_ride/scooter_light_blue",
