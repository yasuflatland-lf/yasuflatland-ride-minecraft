{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "yasu_ride:camper",
      "materials": {
        "default": "entity",
        "glow": "entity_emissive_alpha",
        "lamp": "entity",
        "lamp_lit": "entity_emissive",
        "glass": "entity_alphablend"
      },
      "textures": {
        "default": "textures/entity/yasu_ride/camper",
        "green": "textures/entity/yasu_ride/camper_green",
        "red": "textures/entity/yasu_ride/camper_red",
        "white": "textures/entity/yasu_ride/camper_white",
        "light_gray": "textures/entity/yasu_ride/camper_light_gray",
        "gray": "textures/entity/yasu_ride/camper_gray",
        "black": "textures/entity/yasu_ride/camper_black",
        "orange": "textures/entity/yasu_ride/camper_orange",
        "yellow": "textures/entity/yasu_ride/camper_yellow",
        "lime": "textures/entity/yasu_ride/camper_lime",
        "cyan": "textures/entity/yasu_ride/camper_cyan",
        "light_blue": "textures/entity/yasu_ride/camper_light_blue",
        "blue": "textures/entity/yasu_ride/camper_blue",
        "purple": "textures/entity/yasu_ride/camper_purple",
        "magenta": "textures/entity/yasu_ride/camper_magenta",
        "pink": "textures/entity/yasu_ride/camper_pink",
        "lit": "textures/entity/yasu_ride/camper_lit"
      },
      "geometry": {
        "default": "geometry.yasu_ride.camper"
      },
      "render_controllers": [
        "controller.render.yasu_ride.camper",
        {
          "controller.render.yasu_ride.camper.lit": "query.property('yasu_ride:headlights') || query.property('yasu_ride:ceiling_lights')"
        }
      ],
      "animations": {
        "dive": "animation.yasu_ride.camper.dive",
        "submerged": "animation.yasu_ride.camper.submerged",
        "surface": "animation.yasu_ride.camper.surface",
        "wheels": "animation.yasu_ride.camper.wheels",
        "wheels_deploy": "animation.yasu_ride.camper.wheels_deploy",
        "wheels_folded": "animation.yasu_ride.camper.wheels_folded",
        "wheels_retract": "animation.yasu_ride.camper.wheels_retract",
        "hover_glow": "animation.yasu_ride.camper.hover_glow",
        "bank": "animation.yasu_ride.camper.bank",
        "exhaust": "animation.yasu_ride.camper.exhaust",
        "engine_sound_0": "animation.yasu_ride.camper.engine_sound_0",
        "engine_sound_1": "animation.yasu_ride.camper.engine_sound_1",
        "engine_sound_2": "animation.yasu_ride.camper.engine_sound_2",
        "engine_sound_3": "animation.yasu_ride.camper.engine_sound_3",
        "engine_sound_4": "animation.yasu_ride.camper.engine_sound_4",
        "engine_sound_5": "animation.yasu_ride.camper.engine_sound_5",
        "hover_sound_0": "animation.yasu_ride.camper.hover_sound_0",
        "hover_sound_1": "animation.yasu_ride.camper.hover_sound_1",
        "hover_sound_2": "animation.yasu_ride.camper.hover_sound_2",
        "hover_sound_3": "animation.yasu_ride.camper.hover_sound_3",
        "hover_sound_4": "animation.yasu_ride.camper.hover_sound_4",
        "submarine_sound": "animation.yasu_ride.camper.submarine_sound",
        "form": "controller.animation.yasu_ride.camper.form",
        "door": "animation.yasu_ride.camper.door",
        "shower_door": "animation.yasu_ride.camper.shower_door",
        "cabinet_sink_door": "animation.yasu_ride.camper.cabinet_sink_door",
        "cabinet_stove_door": "animation.yasu_ride.camper.cabinet_stove_door",
        "fridge_top_door": "animation.yasu_ride.camper.fridge_top_door",
        "fridge_bottom_door": "animation.yasu_ride.camper.fridge_bottom_door",
        "shower": "animation.yasu_ride.camper.shower",
        "shower_sound": "animation.yasu_ride.camper.shower_sound"
      },
      "sound_effects": {
        "engine_0": "yasu_ride.engine_0",
        "engine_1": "yasu_ride.engine_1",
        "engine_2": "yasu_ride.engine_2",
        "engine_3": "yasu_ride.engine_3",
        "engine_4": "yasu_ride.engine_4",
        "engine_5": "yasu_ride.engine_5",
        "hover_0": "yasu_ride.hover_0",
        "hover_1": "yasu_ride.hover_1",
        "hover_2": "yasu_ride.hover_2",
        "hover_3": "yasu_ride.hover_3",
        "hover_4": "yasu_ride.hover_4",
        "hover_start": "yasu_ride.hover_start",
        "sonar": "yasu_ride.sonar",
        "shower": "yasu_ride.shower"
      },
      "particle_effects": {
        "exhaust": "minecraft:basic_smoke_particle",
        "hover_glow": "yasu_ride:hover_glow",
        "shower": "yasu_ride:shower_spray"
      },
      "scripts": {
        "animate": [
          "form",
          "bank",
          {
            "exhaust": "query.has_rider"
          },
          {
            "engine_sound_0": "query.has_rider && query.property('yasu_ride:form') == 'car' && query.ground_speed < 1"
          },
          {
            "engine_sound_1": "query.has_rider && query.property('yasu_ride:form') == 'car' && query.ground_speed >= 1 && query.ground_speed < 4.5"
          },
          {
            "engine_sound_2": "query.has_rider && query.property('yasu_ride:form') == 'car' && query.ground_speed >= 4.5 && query.ground_speed < 8"
          },
          {
            "engine_sound_3": "query.has_rider && query.property('yasu_ride:form') == 'car' && query.ground_speed >= 8 && query.ground_speed < 11.5"
          },
          {
            "engine_sound_4": "query.has_rider && query.property('yasu_ride:form') == 'car' && query.ground_speed >= 11.5 && query.ground_speed < 15"
          },
          {
            "engine_sound_5": "query.has_rider && query.property('yasu_ride:form') == 'car' && query.ground_speed >= 15"
          },
          "door",
          "shower_door",
          "cabinet_sink_door",
          "cabinet_stove_door",
          "fridge_top_door",
          "fridge_bottom_door",
          { "shower": "q.property('yasu_ride:shower')" },
          { "shower_sound": "q.property('yasu_ride:shower')" }
        ]
      }
    }
  }
}
