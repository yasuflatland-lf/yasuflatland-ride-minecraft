{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "yasu_ride:jet_foam",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": 3 },
      "minecraft:emitter_lifetime_once": { "active_time": 0.1 },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.2,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.2, 1.8)"
      },
      "minecraft:particle_initial_speed": 1.2,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 2.0, 0],
        "linear_drag_coefficient": 3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.15 + variable.particle_age * 0.25",
          "0.15 + variable.particle_age * 0.25"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [32, 0],
          "uv_size": [8, 8]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1.0,
          1.0,
          1.0,
          "0.9 * (1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
