{
  "name": "yasuflatland-ride-minecraft",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:lang": "node scripts/check-language.mjs",
    "lint:unused": "knip",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage '--coverage.include=src/**' --coverage.reporter=text --coverage.reporter=lcov",
    "test:mutation": "stryker run",
    "model": "python3 -I tools/run_generators.py",
    "sounds": "python3 -I tools/gen_sounds.py packs/yasu_ride_rp",
    "model:check": "python3 -I tools/run_generators.py --check",
    "server:up": "node scripts/server-up.mjs",
    "server:down": "docker compose -f server/compose.yaml down",
    "server:restart": "docker compose -f server/compose.yaml down && node scripts/server-up.mjs",
    "test:game": "node scripts/game-test.mjs",
    "docs": "node scripts/docs.mjs --write",
    "lint:docs": "node scripts/docs.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@minecraft/server": "2.11.0",
    "@minecraft/server-ui": "2.3.0",
    "@minecraft/vanilla-data": "1.26.60",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@swc/core": "1.16.22",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "knip": "6.45.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
