{
  "$schema": "https://unpkg.com/knip@6.41.0/schema.json",
  "ignoreDependencies": ["@swc/core"],
  "ignoreExportsUsedInFile": true,
  "project": [
    "src/**/*.ts!",
    "*.ts",
    "./!(src)/**/*.ts",
    "**/*.{js,mjs,cjs,jsx,tsx,mts,cts}"
  ],
  "entry": [
    "src/buildFlags.d.ts!",
    "src/main.ts!",
    "src/test-pack/runner.ts!",
    "knip.production.mjs",
    "knip.release.mjs",
    "scripts/check-rp-version.d.mts",
    "scripts/dev-pack-version.d.mts",
    "scripts/docs.d.mts",
    "scripts/repo-files.d.mts",
    "scripts/release-subscriptions.d.mts"
  ]
}
